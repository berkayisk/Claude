{
 "vo": [
  {
   "k": "n1",
   "metin": "Herkesin bir gece yarısı fikri vardır.",
   "bas": 0.4,
   "son": 2.44,
   "ic": false
  },
  {
   "k": "n2",
   "metin": "Ahmet'in fikri ise, e-ticaret.",
   "bas": 3.0,
   "son": 5.34,
   "ic": false
  },
  {
   "k": "n3",
   "metin": "O gece, sonunda başlamaya karar verdi.",
   "bas": 5.6,
   "son": 7.82,
   "ic": false
  },
  {
   "k": "n4",
   "metin": "İlk arama masum görünüyordu.",
   "bas": 8.7,
   "son": 10.44,
   "ic": false
  },
  {
   "k": "n5",
   "metin": "Sonra sekmeler çoğaldı.",
   "bas": 10.6,
   "son": 12.11,
   "ic": false
  },
  {
   "k": "n6",
   "metin": "Ne satacaktı? Ürünü nereden bulacaktı?",
   "bas": 12.26,
   "son": 14.9,
   "ic": false
  },
  {
   "k": "n7",
   "metin": "Şirket şart mıydı? Stokları nereye koyacaktı?",
   "bas": 15.05,
   "son": 17.93,
   "ic": false
  },
  {
   "k": "n8",
   "metin": "Her cevap, iki yeni soru getiriyordu.",
   "bas": 18.08,
   "son": 20.39,
   "ic": false
  },
  {
   "k": "i1",
   "metin": "Ben daha ne satacağımı bile bilmiyorum...",
   "bas": 21.3,
   "son": 23.39,
   "ic": true
  },
  {
   "k": "i2",
   "metin": "Belki de bu iş bana göre değil.",
   "bas": 24.0,
   "son": 25.75,
   "ic": true
  },
  {
   "k": "n9",
   "metin": "Çoğu insanın hikâyesi, tam burada biter.",
   "bas": 26.2,
   "son": 28.73,
   "ic": false
  },
  {
   "k": "n10",
   "metin": "Ama Ahmet, o gece uyuyamadı.",
   "bas": 29.6,
   "son": 32.01,
   "ic": false
  },
  {
   "k": "n11",
   "metin": "Ve karşısına, aklına hiç gelmeyen bir soru çıktı.",
   "bas": 32.4,
   "son": 35.18,
   "ic": false
  },
  {
   "k": "n12",
   "metin": "Ya ürün üretmeden, stok tutmadan da başlamak mümkünse?",
   "bas": 35.33,
   "son": 38.46,
   "ic": false
  },
  {
   "k": "n13",
   "metin": "Peki sonra ne oldu?",
   "bas": 38.85,
   "son": 40.16,
   "ic": false
  },
  {
   "k": "n14",
   "metin": "Sabah olduğunda, masasında bir liste vardı.",
   "bas": 42.8,
   "son": 45.6,
   "ic": false
  },
  {
   "k": "n15",
   "metin": "Her şeyi bilmesi gerekmiyordu.",
   "bas": 45.75,
   "son": 47.37,
   "ic": false
  },
  {
   "k": "n16",
   "metin": "Önce doğru modeli öğrenecek, sonra ilk adımı atacaktı.",
   "bas": 47.52,
   "son": 50.88,
   "ic": false
  },
  {
   "k": "n17",
   "metin": "Aylar sonra ilk kez, içi rahattı.",
   "bas": 51.03,
   "son": 53.05,
   "ic": false
  },
  {
   "k": "n18",
   "metin": "Ta ki üç gün sonra, telefonu titreyene kadar.",
   "bas": 53.2,
   "son": 56.24,
   "ic": false
  },
  {
   "k": "n19",
   "metin": "Mesajı okudu. Ve olduğu yerde kaldı.",
   "bas": 57.5,
   "son": 60.22,
   "ic": false
  },
  {
   "k": "n20",
   "metin": "O mesajda ne yazıyordu? Cevabı, ikinci bölümde.",
   "bas": 60.37,
   "son": 64.06,
   "ic": false
  },
  {
   "k": "n21",
   "metin": "Ahmet'in ne yapacağını kaçırmamak için takip et.",
