node_modules/
# Büyük medya dosyaları git'e girmesin (klasör yapısı .gitkeep ile korunur)
projeler/*/girdiler/*
projeler/*/ciktilar/*
projeler/*/referanslar/*
!projeler/*/*/.gitkeep
kanal-referanslari/**/*.mov
kanal-referanslari/**/*.mp4
marka/**/*.mp4
marka/**/*.mov
projeler/*/calisma/*
!projeler/*/calisma/*.py
!projeler/*/calisma/transkript.txt
!projeler/*/calisma/transkript.json
!marka/**/*.wav
musteriler/*/projeler/*/girdiler/*
musteriler/*/projeler/*/ciktilar/*
musteriler/*/projeler/*/referanslar/*
musteriler/*/projeler/*/calisma/*
!musteriler/**/.gitkeep

# müşteri medya dosyaları (git dışı)
musteriler/**/*.mov
musteriler/**/*.mp4
musteriler/**/referanslar/kareler/k_*.jpg
musteriler/**/ses/_*/
musteriler/**/ses/uret.log
musteriler/**/ses/uret*.log
musteriler/**/ses/*_ham.wav
musteriler/**/ses_v1_yankili/
musteriler/**/ses_v5_kuru/
musteriler/**/ses_hizli/

__pycache__/
*.pyc
musteriler/**/ses_anlatici/
musteriler/**/ses_elif/
