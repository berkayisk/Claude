node_modules/
# Büyük medya dosyaları git'e girmesin (klasör yapısı .gitkeep ile korunur)
projeler/*/girdiler/*
projeler/*/ciktilar/*
projeler/*/referanslar/*
!projeler/*/*/.gitkeep
kanal-referanslari/**/*.mov
kanal-referanslari/**/*.mp4
marka/**/*.mp4
marka/**/*.mov
projeler/*/calisma/*
!projeler/*/calisma/*.py
!projeler/*/calisma/transkript.txt
!projeler/*/calisma/transkript.json
!marka/**/*.wav
musteriler/*/projeler/*/girdiler/*
musteriler/*/projeler/*/ciktilar/*
musteriler/*/projeler/*/referanslar/*
musteriler/*/projeler/*/calisma/*
!musteriler/**/.gitkeep

# real-sound: indirilen kayıtlar repoya girmez
projeler/*/audio/assets/*
!projeler/*/audio/assets/manifests/
projeler/*/out/*
!projeler/*/out/cues.json

# proje ses varlıkları (müzik lisansı yeniden dağıtıma izin vermez)
projeler/*/audio/muzik/
projeler/*/girdiler/fonts/
